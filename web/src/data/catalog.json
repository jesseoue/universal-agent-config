  "policy": {
    "version": 1,
    "defaults": {
      "provider": "openrouter",
      "telemetry": false,
      "preserve_secrets": true,
      "confirm_destructive_commands": true,
      "allow_shell": true,
      "allow_edit": true,
      "allow_browser": true,
      "max_retries": 5,
      "request_timeout_seconds": 300,
      "stalled_chunk_timeout_seconds": 60
    },
    "performance": {
      "description": "Default speed and stability policy for agent transports.",
      "mcp_timeout_seconds": 30,
      "mcp_startup_timeout_seconds": 10,
      "reasoning_effort": "medium",
      "background_uses_small_model": true,
      "tool_output": {
        "max_lines": 300,
        "max_bytes": 12000
      },
      "compaction": {
        "auto": true,
        "prune": true,
        "reserve_tokens": 16384,
        "keep_recent_tokens": 20000,
        "tail_turns": 2
      },
      "concurrency": {
        "default": 10,
        "provider": 12,
        "expensive": 5,
        "analysis": 2,
        "max_depth": 2
      },
      "escalation": {
        "frontier_default": false,
        "trigger_after_failed_attempts": 2,
        "high_blast_radius_only": true
      }
    },
    "profiles": {
      "balanced": {
        "inherits": "defaults"
      },
      "open-weight": {
        "inherits": "defaults"
      },
      "low-cost": {
        "inherits": "defaults"
      },
      "frontier": {
        "inherits": "defaults"
      },
      "implement": {
        "inherits": "defaults"
      },
      "content-analysis": {
        "inherits": "defaults",
        "allow_shell": false,
        "allow_edit": false,
        "allow_browser": false
      }
    },
    "advanced": {
      "description": "Explicit opt-in profile for experienced users.",
      "inherits": "defaults",
      "confirm_destructive_commands": false
    },
    "openrouter_routing": {
      "default_strategy": "latency",
      "strategies": [
        "latency",
        "throughput",
        "price",
        "auto"
      ],
      "provider_controls": {
        "sort": [
          "price",
          "throughput",
          "latency"
        ],
        "allow_fallbacks": true,
        "require_parameters": true,
        "data_collection": "deny",
        "zdr": true,
        "ignore": []
      },
      "fallbacks": {
        "models": [
          {
            "id": "z-ai/glm-5.3"
          },
          {
            "id": "moonshotai/kimi-k2.7-code"
          }
        ],
        "route": "fallback"
      }
    },
    "verification": {
      "default": "required",
      "read_only_planning": true,
      "targeted_commands": true,
      "exact_output_reporting": true,
      "one_focused_retry": true
    },
    "frontier_policy": {
      "default_enabled": false,
      "requires_explicit_opt_in": true,
      "trigger_after_failed_attempts": 2,
      "high_blast_radius_only": true
    }
  },
  "gateways": [
    {
      "id": "openrouter",
      "name": "OpenRouter",
      "category": "hosted-model-marketplace",
      "base_url": "https://openrouter.ai/api/v1",
      "api_key_env": "OPENROUTER_API_KEY",
      "protocol": "openai-chat-completions",
      "model_format": "provider/model",
      "best_for": [
        "Broad model and provider access with one key",
        "Fast setup across many agents",
        "Long-tail and newly released models"
      ],
      "caveats": [
        "Hosted control plane; account, credits, and routing policy live with OpenRouter",
        "Provider routing is controlled by OpenRouter rather than your infrastructure",
        "Credit purchases can carry platform fees"
      ]
    },
    {
      "id": "cloudflare",
      "name": "Cloudflare AI Gateway",
      "category": "edge-control-plane",
      "base_url_template": "https://api.cloudflare.com/client/v4/accounts/{account_id}/ai/v1",
      "api_key_env": "CLOUDFLARE_API_TOKEN",
      "protocol": "openai-chat-completions",
      "model_format": "provider/model",
      "headers": {
        "cf-aig-gateway-id": "default"
      },
      "best_for": [
        "Teams already using Cloudflare Workers or Cloudflare security tooling",
        "Edge caching, retries, logs, rate limits, and DLP",
        "Keeping provider credentials and contracts under your control"
      ],
      "caveats": [
        "Requires a Cloudflare account ID and API token",
        "Dynamic routes are managed in Cloudflare rather than local config",
        "Gateway Run tokens are account-scoped, so key policy must be carefully designed"
      ]
    },
    {
      "id": "vercel",
      "name": "Vercel AI Gateway",
      "category": "developer-gateway",
      "base_url": "https://ai-gateway.vercel.sh",
      "api_key_env": "AI_GATEWAY_API_KEY",
      "protocol": "provider-model-strings",
      "model_format": "provider/model",
      "best_for": [
        "Vercel-native deployments and OIDC-based auth",
        "Fast multi-agent setup with provider failover and spend visibility",
        "Claude Code compatibility through an Anthropic-compatible endpoint"
      ],
      "caveats": [
        "Strongest when your runtime and observability already live on Vercel",
        "OIDC token lifetime is short outside Vercel deployments",
        "Gateway-specific routing options belong in application provider options"
      ]
    },
    {
      "id": "litellm",
      "name": "LiteLLM Proxy",
      "category": "self-hosted-proxy",
      "base_url_env": "LITELLM_PROXY_API_BASE",
      "api_key_env": "LITELLM_PROXY_API_KEY",
      "protocol": "openai-compatible",
      "model_format": "litellm-proxy/model-name",
      "best_for": [
        "Self-hosted control over provider keys and logs",
        "Existing Azure, Bedrock, Vertex, or direct-provider contracts",
        "Virtual keys, budgets, cooldowns, retries, and ordered fallbacks"
      ],
      "caveats": [
        "You operate the proxy and its persistence layer",
        "Model IDs are normalized through LiteLLM rather than the provider catalog",
        "Production reliability usually requires Redis-backed router state"
      ]
    },
    {
      "id": "portkey",
      "name": "Portkey AI Gateway",
      "category": "managed-governance-gateway",
      "base_url": "https://api.portkey.ai/v1",
      "api_key_env": "PORTKEY_API_KEY",
      "protocol": "openai-compatible",
      "model_format": "@provider/model",
      "best_for": [
        "Managed routing, guardrails, governance, and audit trails",
        "Fallback and load-balancing config stored as reusable policies",
        "Organizations that need centralized policy without operating a proxy"
      ],
      "caveats": [
        "Provider credentials and routing policies are managed in Portkey",
        "Some model pricing must be configured for accurate cost analytics",
        "Saved config IDs are external state"
      ]
    }
  ],
  "defaultGateway": "openrouter",
