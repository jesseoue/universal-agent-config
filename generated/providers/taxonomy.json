  "media_providers": [
    {
      "name": "fal",
      "protocol": "fal-queue-api",
      "base_url": "https://fal.run",
      "api_key_env": "FAL_KEY",
      "best_for": [
        "Fast image, video, audio, speech, and 3D generation",
        "Direct model endpoints with queue semantics"
      ],
      "caveats": [
        "Not an OpenAI-compatible chat API",
        "Each model has its own endpoint schema",
        "Async queue operations require polling or webhook integration"
      ]
    },
    {
      "name": "replicate",
      "protocol": "replicate-predictions-api",
      "base_url": "https://api.replicate.com/v1",
      "api_key_env": "REPLICATE_API_TOKEN",
      "best_for": [
        "Community model registry and reproducible predictions",
        "Image, video, audio, and custom models"
      ],
      "caveats": [
        "Not an OpenAI-compatible chat API",
        "Prediction lifecycle uses create/poll/cancel semantics",
        "Model versions and hardware choices affect cost and latency"
      ]
    }
  ],
  "inference_runtimes": [
